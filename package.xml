<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>spacemouse_teleop</name>
  <version>0.1.0</version>
  <description>Robot-agnostic SpaceMouse teleoperation: HID driver + pose-command interface, configured per robot (Franka / KUKA) via YAML.</description>
  <maintainer email="todo@todo.todo">todo</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <!-- gripper_teleop ("hand teleop") speaks Franka gripper action MESSAGES only;
       it does NOT depend on the franka_gripper hardware pkg (that server is robot-side). -->
  <exec_depend>franka_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <!-- pyspacemouse is pip-only: pip install pyspacemouse (and its hidapi system dep) -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
